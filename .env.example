# Local development only. Never commit a filled .env. Generate values with: openssl rand -hex 24
POSTGRES_PASSWORD=
CLUSTERX_APP_DB_PASSWORD=
CLUSTERX_METRICS_TOKEN=
# Optional
CLUSTERX_PG_PORT=5432
# Optional host ports and image name prefix (run a second, separate stack: also set COMPOSE_PROJECT_NAME)
CLUSTERX_HTTP_PORT=8080
CLUSTERX_METRICS_PORT=9091
CLUSTERX_IMAGE_PREFIX=clusterx
