{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "CLUSTERX web: public site, docs, console, isolated demo, BFF skeleton (M3 foundation).",
  "scripts": {
    "dev": "next dev --turbopack",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "build": "next build",
    "start": "node server.ts",
    "e2e": "playwright test",
    "dev:live": "NODE_ENV=development node server.ts"
  },
  "dependencies": {
    "@clusterx/sdk-ts": "workspace:*",
    "@clusterx/ui": "workspace:*",
    "ajv": "8.17.1",
    "jose": "6.2.18",
    "marked": "18.2.1",
    "next": "16.4.6",
    "openid-client": "6.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "ws": "8.23.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
