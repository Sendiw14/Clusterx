{
  "name": "@clusterx/sdk-ts",
  "version": "1.0.0-draft.4",
  "private": true,
  "type": "module",
  "description": "GENERATED typed REST client types for CLUSTERX /api/v1. Do not hand-edit src/schema.d.ts; run `pnpm sdk:generate`.",
  "exports": { ".": { "types": "./src/index.ts", "default": "./src/index.ts" } },
  "scripts": {
    "generate": "openapi-typescript ../../api/openapi.yaml -o src/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": { "openapi-fetch": "0.17.0" },
  "devDependencies": { "openapi-typescript": "7.13.0", "typescript": "5.9.3" }
}
