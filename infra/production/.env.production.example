# CLUSTERX production example settings. NO CREDENTIALS IN THIS FILE: every secret is a file under ./secrets/
# (see docs/operations/deployment.md). Copy to .env.production (gitignored) and edit.
COMPOSE_PROJECT_NAME=clusterx-prod
# Public hostnames served by Caddy (console and direct API). DNS must point at this host.
CLUSTERX_WEB_HOST=console.example.com
CLUSTERX_API_HOST=api.example.com
# files: certificates from ./secrets/site.{crt,key}; acme: Caddy obtains public certificates (needs a real domain).
CLUSTERX_TLS_MODE=acme
# Published ports (0.0.0.0 on a server; the local proof uses 127.0.0.1 and high ports).
CLUSTERX_BIND_ADDR=0.0.0.0
CLUSTERX_HTTPS_PORT=443
CLUSTERX_HTTP_REDIRECT_PORT=80
# Only when CLUSTERX_HTTPS_PORT is not 443: ":<port>" so the console origin and WebSocket origin match.
CLUSTERX_PUBLIC_PORT_SUFFIX=
CLUSTERX_PROMETHEUS_PORT=9190
CLUSTERX_IMAGE_PREFIX=clusterx
CLUSTERX_VERSION=local
